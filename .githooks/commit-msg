#!/bin/sh
# Reject AI-assistant attribution trailers in commit messages.
#
# S1Atlas is a public repository; keep commit messages clean. Install once per clone:
#   git config core.hooksPath .githooks
# (or copy this file:  cp .githooks/commit-msg .git/hooks/  &&  chmod +x .git/hooks/commit-msg)
#
# Local only: it does not cover commits made through the GitHub web UI, contributors
# who have not installed it, or anyone passing --no-verify.

if grep -qiE '^Co-Authored-By:[[:space:]]*(Claude|Codex|OpenAI|Anthropic)|Generated with \[?Claude|Generated with \[?Codex|generated by (Claude|Codex)' "$1"; then
  echo "commit-msg: AI-assistant attribution trailer found in the commit message." >&2
  echo "S1Atlas is public — remove it before committing." >&2
  exit 1
fi

exit 0
