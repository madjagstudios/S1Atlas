<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>s1atlas-mcp</ToolCommandName>
    <PackageId>S1Atlas.Mcp</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/madjagstudios/S1Atlas</RepositoryUrl>
    <Description>Read-only MCP stdio server for Schedule I developer intelligence.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <ProjectReference Include="..\S1Atlas.Application\S1Atlas.Application.csproj" />
    <ProjectReference Include="..\S1Atlas.Core\S1Atlas.Core.csproj" />
    <ProjectReference Include="..\S1Atlas.Indexing\S1Atlas.Indexing.csproj" />
    <ProjectReference Include="..\S1Atlas.Storage\S1Atlas.Storage.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.8" />
  </ItemGroup>
</Project>
