<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\S1Atlas.Application\S1Atlas.Application.csproj" />
    <ProjectReference Include="..\..\src\S1Atlas.Indexing\S1Atlas.Indexing.csproj" />
    <ProjectReference Include="..\..\src\S1Atlas.Storage\S1Atlas.Storage.csproj" />
    <ProjectReference Include="..\Fixtures\S1Atlas.ManagedAssemblyFixture\S1Atlas.ManagedAssemblyFixture.csproj" />
    <ProjectReference Include="..\Fixtures\S1Atlas.InteropAssemblyFixture\S1Atlas.InteropAssemblyFixture.csproj" />
    <ProjectReference Include="..\Fixtures\S1Atlas.TestSupport\S1Atlas.TestSupport.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <!-- The script-layout fixture is also named Assembly-CSharp, so it is copied into its own
       subfolder instead of beside the ManagedAssemblyFixture. -->
  <ItemGroup>
    <ProjectReference Include="..\Fixtures\S1Atlas.ScriptLayoutFixture\S1Atlas.ScriptLayoutFixture.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="ScriptLayoutFixtureAssembly" />
  </ItemGroup>
  <Target Name="CopyScriptLayoutFixture" AfterTargets="Build">
    <Copy SourceFiles="@(ScriptLayoutFixtureAssembly)" DestinationFolder="$(OutDir)script-layout-fixture" SkipUnchangedFiles="true" />
  </Target>
  <!-- The parity fixture is indexed from its own subfolder and never loaded. -->
  <ItemGroup>
    <ProjectReference Include="..\Fixtures\S1Atlas.ParityFixture\S1Atlas.ParityFixture.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="ParityFixtureAssembly" />
  </ItemGroup>
  <Target Name="CopyParityFixture" AfterTargets="Build">
    <Copy SourceFiles="@(ParityFixtureAssembly)" DestinationFolder="$(OutDir)parity-fixture" SkipUnchangedFiles="true" />
  </Target>
  <!-- The harmony fixtures are indexed from their own subfolder and never loaded. -->
  <ItemGroup>
    <ProjectReference Include="..\Fixtures\S1Atlas.HarmonyGameFixture\S1Atlas.HarmonyGameFixture.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="HarmonyGameFixtureAssembly" />
    <ProjectReference Include="..\Fixtures\S1Atlas.HarmonyModFixture\S1Atlas.HarmonyModFixture.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="HarmonyModFixtureAssembly" />
  </ItemGroup>
  <Target Name="CopyHarmonyFixtures" AfterTargets="Build">
    <Copy SourceFiles="@(HarmonyGameFixtureAssembly)" DestinationFolder="$(OutDir)harmony-fixture" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(HarmonyModFixtureAssembly)" DestinationFolder="$(OutDir)harmony-fixture" SkipUnchangedFiles="true" />
  </Target>
</Project>
