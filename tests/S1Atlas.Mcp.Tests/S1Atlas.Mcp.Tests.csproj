<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\S1Atlas.Application\S1Atlas.Application.csproj" />
    <ProjectReference Include="..\..\src\S1Atlas.Cli\S1Atlas.Cli.csproj" />
    <ProjectReference Include="..\..\src\S1Atlas.Extraction\S1Atlas.Extraction.csproj" />
    <ProjectReference Include="..\..\src\S1Atlas.Indexing\S1Atlas.Indexing.csproj" />
    <ProjectReference Include="..\..\src\S1Atlas.Mcp\S1Atlas.Mcp.csproj" />
    <ProjectReference Include="..\..\src\S1Atlas.Storage\S1Atlas.Storage.csproj" />
    <ProjectReference Include="..\Fixtures\S1Atlas.TestSupport\S1Atlas.TestSupport.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <!-- The harmony fixtures are indexed from their own subfolder and never loaded. -->
  <ItemGroup>
    <ProjectReference Include="..\Fixtures\S1Atlas.HarmonyGameFixture\S1Atlas.HarmonyGameFixture.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="HarmonyGameFixtureAssembly" />
    <ProjectReference Include="..\Fixtures\S1Atlas.HarmonyModFixture\S1Atlas.HarmonyModFixture.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="HarmonyModFixtureAssembly" />
  </ItemGroup>
  <Target Name="CopyHarmonyFixtures" AfterTargets="Build">
    <Copy SourceFiles="@(HarmonyGameFixtureAssembly)" DestinationFolder="$(OutDir)harmony-fixture" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(HarmonyModFixtureAssembly)" DestinationFolder="$(OutDir)harmony-fixture" SkipUnchangedFiles="true" />
  </Target>
</Project>
